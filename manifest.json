{
  "manifest_version": 3,
  "name": "YT Gatekeeper",
  "version": "1.0.0",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["Content.js", "timekeeper.js"]
    }
  ],
  "web_accessible_resources":[
    {
      "resources": ["resources/overlay.html", "resources/overlay.css"],
      "matches": ["https://www.youtube.com/*"]
    }
  ],
  "permissions":["storage"],
  "background": {
      "service_worker": "background.js"
    }
}
